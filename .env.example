# Supabase (Project Settings → API). Publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public site URL (used for sitemap / social cards)
NEXT_PUBLIC_SITE_URL=https://riverinaresidence.com
# Optional: e-mail notifications for new enquiries via Resend (resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=Riverina Residence <upiti@riverinaresidence.com>
